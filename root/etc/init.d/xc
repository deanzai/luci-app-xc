#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="restart_prepared"
EXTRA_HELP="\trestart_prepared Restart using the runtime-prepared configuration"

start_service() {
	mkdir -p /etc/xc/rollback /var/etc/xc /var/log || return 1
	chmod 0700 /etc/xc /etc/xc/rollback /var/etc/xc || return 1
	chmod 0600 /etc/config/xc || return 1
	[ "$(uci -q get xc.global.enabled)" = "1" ] || return 0
	if [ "$XC_RUNTIME_PREPARED" != "1" ]; then
		/usr/bin/xc recover-pending || return 1
		/usr/bin/xc render --output /var/etc/xc/config.json || return 1
	fi
	procd_open_instance
	procd_set_param command /usr/bin/xray run -c /var/etc/xc/config.json
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/xc
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop || return 1
	start
}

restart_prepared() {
	XC_RUNTIME_PREPARED=1
	stop || return 1
	start
}

service_triggers() {
	procd_add_reload_trigger xc network
}
