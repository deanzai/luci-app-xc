#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="restart_prepared"
EXTRA_HELP="\trestart_prepared Restart using the runtime-prepared configuration"

resolve_xray() {
	local current=system
	if [ -f /etc/xc/xray/current ]; then
		IFS= read -r current < /etc/xc/xray/current || return 1
	fi
	case "$current" in
		system)
			[ -x /usr/bin/xray ] || return 1
			echo /usr/bin/xray
			;;
	v*)
	case "$current" in *[!a-z0-9_-]*) return 1 ;; esac
		local path="/etc/xc/xray/versions/$current/xray"
		local manifest="/etc/xc/xray/versions/$current/manifest.json"
		local manifest_id manifest_size manifest_sha256 manifest_length actual_size actual_sha256
		[ -f "$path" ] && [ ! -L "$path" ] && [ -x "$path" ] || return 1
		[ -f "$manifest" ] && [ ! -L "$manifest" ] || return 1
		local path_mode manifest_mode
		path_mode="$(ls -ld "$path" 2>/dev/null)" || return 1
		manifest_mode="$(ls -ld "$manifest" 2>/dev/null)" || return 1
		case "$path_mode" in -rwx------*) ;; *) return 1 ;; esac
		case "$manifest_mode" in -rw-------*) ;; *) return 1 ;; esac
		manifest_id="$(sed -n 's/.*\"id\":\"\([^\"]*\)\".*/\1/p' "$manifest")"
		manifest_size="$(sed -n 's/.*\"size\":\([0-9][0-9]*\).*/\1/p' "$manifest")"
		manifest_sha256="$(sed -n 's/.*\"sha256\":\"\([0-9A-Fa-f]*\)\".*/\1/p' "$manifest")"
		[ "$manifest_id" = "$current" ] || return 1
		case "$manifest_size" in ''|*[!0-9]*) return 1 ;; esac
		manifest_length="$(printf '%s' "$manifest_sha256" | wc -c)"
		[ "$manifest_length" = "64" ] || return 1
		[ -z "$(printf '%s' "$manifest_sha256" | tr -d '0-9A-Fa-f')" ] || return 1
		actual_size="$(wc -c < "$path")"
		[ "$actual_size" = "$manifest_size" ] || return 1
		actual_sha256="$(sha256sum "$path" 2>/dev/null | cut -d' ' -f1)"
		[ "$actual_sha256" = "$manifest_sha256" ] || return 1
		echo "$path"
			;;
		*)
			return 1
			;;
	esac
}

resolve_asset_dir() {
	local asset_dir
	for asset_dir in /usr/share/xray /usr/share/v2ray; do
		[ -f "$asset_dir/geosite.dat" ] && [ -f "$asset_dir/geoip.dat" ] || continue
		echo "$asset_dir"
		return 0
	done
	return 1
}

start_service() {
	local xray_path asset_dir
	asset_dir="$(resolve_asset_dir 2>/dev/null)" || asset_dir=""
	if [ -n "$asset_dir" ]; then
		export XRAY_LOCATION_ASSET="$asset_dir"
	else
		unset XRAY_LOCATION_ASSET
	fi
	mkdir -p /etc/xc/rollback /etc/xc/xray/versions /var/etc/xc /var/log || return 1
	chmod 0700 /etc/xc /etc/xc/rollback /etc/xc/xray /etc/xc/xray/versions /var/etc/xc || return 1
	chmod 0600 /etc/config/xc || return 1
	[ "$(uci -q get xc.global.enabled)" = "1" ] || return 0
	if [ "$XC_RUNTIME_PREPARED" != "1" ]; then
		if [ -f /etc/xc/xray/transaction ]; then
			/usr/bin/xc core-recover || return 1
		fi
		/usr/bin/xc recover-pending || return 1
		/usr/bin/xc render-dynamic --output /var/etc/xc/config.json || return 1
	fi
	xray_path="$(resolve_xray)" || return 1
	procd_open_instance
	procd_set_param command "$xray_path" run -c /var/etc/xc/config.json
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/xc
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	(
		api_attempts=0
		api_ready=0
		while [ "$api_attempts" -lt 60 ]; do
			if "$xray_path" api bi --server=127.0.0.1:10085 xc-balancer >/dev/null 2>&1; then
				api_ready=1
				break
			fi
			api_attempts=$((api_attempts + 1))
			[ "$api_attempts" -lt 60 ] || break
			sleep 1
		done
		if [ "$api_ready" = "1" ]; then
			/usr/bin/xc restore-selection >/dev/null 2>&1 || /usr/bin/xc log-event selection_restore_failed >/dev/null 2>&1 || true
		else
			/usr/bin/xc log-event selection_restore_failed >/dev/null 2>&1 || true
		fi
	) >/dev/null 2>&1 &
	/usr/bin/xc log-event service_started >/dev/null 2>&1 || true
}

stop_service() {
	/usr/bin/xc log-event service_stopped >/dev/null 2>&1 || true
}

reload_service() {
	stop || return 1
	start
}

restart_prepared() {
	XC_RUNTIME_PREPARED=1
	stop || return 1
	start
}

service_triggers() {
	procd_add_reload_trigger xc network
}
